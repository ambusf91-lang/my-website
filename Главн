<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Тени — город сервера Polit Core</title>

  <style>
    :root {
      --bg: #070b14;
      --bg-light: #0d1422;
      --card: #111b2d;
      --card-hover: #172640;
      --text: #edf5ff;
      --muted: #91a3b9;
      --blue: #4ba9ff;
      --cyan: #64e5ed;
      --purple: #876bff;
      --gold: #e4b96e;
      --red: #ff6d7d;
      --green: #4ee29c;
      --border: rgba(255, 255, 255, .1);
      --shadow: 0 18px 50px rgba(0, 0, 0, .3);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      color: var(--text);
      background:
        linear-gradient(rgba(7, 11, 20, .82), rgba(7, 11, 20, .97)),
        radial-gradient(circle at 85% 0%, rgba(75, 169, 255, .25), transparent 32%),
        radial-gradient(circle at 5% 30%, rgba(135, 107, 255, .13), transparent 30%),
        var(--bg);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input {
      font: inherit;
    }

    .container {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(7, 11, 20, .86);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }

    .navbar {
      min-height: 72px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 11px;
      font-size: 19px;
      font-weight: 800;
      white-space: nowrap;
    }

    .logo-icon {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      color: white;
      background: linear-gradient(135deg, var(--blue), var(--purple));
      box-shadow: 0 0 24px rgba(75, 169, 255, .35);
      font-size: 21px;
    }

    .logo span {
      color: var(--cyan);
    }

    nav {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    nav a {
      padding: 9px 13px;
      border-radius: 8px;
      color: var(--muted);
      transition: .2s;
    }

    nav a:hover {
      color: var(--text);
      background: var(--bg-light);
    }

    .menu-button {
      display: none;
      padding: 8px 12px;
      color: white;
      background: var(--bg-light);
      border: 1px solid var(--border);
      border-radius: 8px;
      cursor: pointer;
    }

    .hero {
      min-height: 620px;
      display: grid;
      place-items: center;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 480px;
      height: 480px;
      left: -220px;
      top: 50px;
      border-radius: 50%;
      background: rgba(75, 169, 255, .08);
      filter: blur(5px);
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 380px;
      height: 380px;
      right: -170px;
      bottom: 0;
      border-radius: 50%;
      background: rgba(135, 107, 255, .11);
      filter: blur(8px);
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 850px;
    }

    .server-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 14px;
      margin-bottom: 23px;
      color: var(--cyan);
      background: rgba(100, 229, 237, .08);
      border: 1px solid rgba(100, 229, 237, .28);
      border-radius: 999px;
      font-size: 13px;
    }

    .server-label::before {
      content: "";
      width: 8px;
      height: 8px;
      background: var(--green);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--green);
    }

    h1 {
      margin-bottom: 20px;
      font-size: clamp(52px, 10vw, 105px);
      line-height: .95;
      letter-spacing: -4px;
      text-shadow: 0 8px 40px rgba(75, 169, 255, .24);
    }

    h1 span {
      color: var(--cyan);
    }

    .hero-description {
      max-width: 700px;
      margin: auto;
      color: var(--muted);
      font-size: 18px;
    }

    .hero-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }

    .button {
      display: inline-block;
      padding: 12px 19px;
      color: white;
      background: linear-gradient(135deg, var(--blue), var(--purple));
      border: 0;
      border-radius: 10px;
      cursor: pointer;
      transition: .2s;
    }

    .button:hover {
      transform: translateY(-2px);
      filter: brightness(1.12);
    }

    .button.secondary {
      background: var(--bg-light);
      border: 1px solid var(--border);
    }

    section {
      padding: 45px 0;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 20px;
    }

    .section-heading h2 {
      font-size: 30px;
      line-height: 1.2;
    }

    .section-heading p {
      margin-top: 5px;
      color: var(--muted);
    }

    .info-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .panel {
      padding: 27px;
      background: rgba(17, 27, 45, .85);
      border: 1px solid var(--border);
      border-radius: 18px;
      box-shadow: var(--shadow);
    }

    .panel h3 {
      margin-bottom: 13px;
      font-size: 22px;
    }

    .panel p {
      color: var(--muted);
    }

    .facts {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 20px;
    }

    .fact {
      padding: 15px;
      border-radius: 12px;
      background: rgba(255, 255, 255, .04);
      border: 1px solid var(--border);
    }

    .fact small {
      display: block;
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 4px;
    }

    .fact strong {
      color: var(--text);
      font-size: 17px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .card {
      min-height: 175px;
      padding: 22px;
      background: rgba(17, 27, 45, .82);
      border: 1px solid var(--border);
      border-radius: 16px;
      cursor: pointer;
      transition: .2s;
    }

    .card:hover {
      transform: translateY(-5px);
      background: var(--card-hover);
      border-color: rgba(100, 229, 237, .45);
    }

    .card-icon {
      margin-bottom: 15px;
      font-size: 32px;
    }

    .card h3 {
      margin-bottom: 7px;
      font-size: 18px;
    }

    .card p {
      color: var(--muted);
      font-size: 14px;
    }

    .timeline {
      padding: 25px;
      background: rgba(17, 27, 45, .82);
      border: 1px solid var(--border);
      border-radius: 18px;
    }

    .event {
      display: grid;
      grid-template-columns: 95px 1fr;
      gap: 20px;
      padding: 17px 0;
      border-bottom: 1px solid var(--border);
    }

    .event:last-child {
      border-bottom: 0;
    }

    .event-date {
      color: var(--gold);
      font-weight: bold;
    }

    .event h3 {
      margin-bottom: 4px;
    }

    .event p {
      color: var(--muted);
    }

    .articles {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .article {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding: 22px;
      background: rgba(17, 27, 45, .82);
      border: 1px solid var(--border);
      border-radius: 15px;
      transition: .2s;
    }

    .article:hover {
      background: var(--card-hover);
      border-color: var(--blue);
    }

    .article h3 {
      margin-bottom: 5px;
    }

    .article p {
      color: var(--muted);
      font-size: 14px;
    }

    .article-date {
      color: var(--cyan);
      white-space: nowrap;
      font-size: 12px;
    }

    .search {
      width: 260px;
      padding: 11px 13px;
      color: white;
      background: var(--bg-light);
      border: 1px solid var(--border);
      border-radius: 9px;
      outline: none;
    }

    .search:focus {
      border-color: var(--blue);
    }

    .discord {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 25px;
      padding: 30px;
      background:
        linear-gradient(100deg, rgba(75, 169, 255, .2), rgba(135, 107, 255, .14)),
        var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
    }

    .discord p {
      color: var(--muted);
      margin-top: 5px;
    }

    footer {
      margin-top: 35px;
      padding: 27px 0;
      color: var(--muted);
      border-top: 1px solid var(--border);
      font-size: 14px;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      gap: 15px;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 50;
      place-items: center;
      padding: 20px;
      background: rgba(0, 0, 0, .75);
    }

    .modal.active {
      display: grid;
    }

    .modal-window {
      width: min(520px, 100%);
      padding: 30px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      box-shadow: var(--shadow);
    }

    .modal-window h2 {
      margin-bottom: 12px;
    }

    .modal-window p {
      margin-bottom: 20px;
      color: var(--muted);
    }

    @media (max-width: 900px) {
      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .info-layout {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .navbar {
        flex-wrap: wrap;
        padding: 12px 0;
      }

      .menu-button {
        display: block;
      }

      nav {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: stretch;
      }

      nav.active {
        display: flex;
      }

      nav a {
        background: var(--bg-light);
      }

      .hero {
        min-height: 540px;
      }

      h1 {
        letter-spacing: -2px;
      }

      .cards,
      .articles {
        grid-template-columns: 1fr;
      }

      .section-heading {
        align-items: stretch;
        flex-direction: column;
      }

      .search {
        width: 100%;
      }

      .discord,
      .footer-content {
        align-items: flex-start;
        flex-direction: column;
      }

      .event {
        grid-template-columns: 1fr;
        gap: 4px;
      }

      .facts {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="container navbar">
      <a href="#" class="logo">
        <span class="logo-icon">✦</span>
        <span>Polit Core</span>
      </a>

      <button class="menu-button" onclick="toggleMenu()">
        ☰
      </button>

      <nav id="navigation">
        <a href="#about">О городе</a>
        <a href="#places">Места</a>
        <a href="#history">История</a>
        <a href="#articles">Статьи</a>
        <a href="#community">Сообщество</a>
      </nav>
    </div>
  </header>

  <main>

    <section class="hero">
      <div class="hero-content">
        <div class="server-label">
          Город сервера Polit Core
        </div>

        <h1>Город <span>Тени</span></h1>

        <p class="hero-description">
          Добро пожаловать в Тени — один из городов мира Polit Core.
          Здесь собрана информация об истории города, его районах,
          законах, жителях и главных событиях.
        </p>

        <div class="hero-buttons">
          <a href="#about" class="button">Исследовать город</a>
          <a href="#articles" class="button secondary">Читать статьи</a>
        </div>
      </div>
    </section>

    <section id="about">
      <div class="container">
        <div class="section-heading">
          <div>
            <h2>О городе</h2>
            <p>Основная информация о Тенях</p>
          </div>
        </div>

        <div class="info-layout">
          <div class="panel">
            <h3>Тени</h3>

            <p>
              Тени — город на сервере Polit Core, известный своей
              атмосферой, политическими событиями и активным сообществом.
              Здесь каждый житель может участвовать в развитии города,
              создавать организации и влиять на его будущее.
            </p>

            <p style="margin-top: 15px;">
              Страница находится в разработке. Информация может изменяться
              после обновлений сервера.
            </p>
          </div>

          <div class="panel">
            <h3>Характеристики города</h3>

            <div class="facts">
              <div class="fact">
                <small>Сервер</small>
                <strong>Polit Core</strong>
              </div>

              <div class="fact">
                <small>Название</small>
                <strong>Тени</strong>
              </div>

              <div class="fact">
                <small>Тип</small>
                <strong>Город</strong>
              </div>

              <div class="fact">
                <small>Статус</small>
                <strong style="color: var(--green);">
                  Активен
                </strong>
              </div>

              <div class="fact">
                <small>Население</small>
                <strong>Не указано</strong>
              </div>

              <div class="fact">
                <small>Правитель</small>
                <strong>Не указано</strong>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="places">
      <div class="container">
        <div class="section-heading">
          <div>
            <h2>Разделы города</h2>
            <p>Выберите интересующий раздел</p>
          </div>
        </div>

        <div class="cards">
          <div class="card" onclick="openModal('История города')">
            <div class="card-icon">📜</div>
            <h3>История</h3>
            <p>
              Основание города, важные события и развитие Теней.
            </p>
          </div>

          <div class="card" onclick="openModal('Районы города')">
            <div class="card-icon">🏙️</div>
            <h3>Районы</h3>
            <p>
              Главные районы, улицы и особые территории города.
            </p>
          </div>

          <div class="card" onclick="openModal('Правительство')">
            <div class="card-icon">🏛️</div>
            <h3>Правительство</h3>
            <p>
              Руководство города, должности и органы управления.
            </p>
          </div>

          <div class="card" onclick="openModal('Законы города')">
            <div class="card-icon">⚖️</div>
            <h3>Законы</h3>
            <p>
              Правила, права жителей и обязанности граждан.
            </p>
          </div>

          <div class="card" onclick="openModal('Экономика')">
            <div class="card-icon">💰</div>
            <h3>Экономика</h3>
            <p>
              Торговля, предприятия, ресурсы и городская казна.
            </p>
          </div>

          <div class="card" onclick="openModal('Организации')">
            <div class="card-icon">⚔️</div>
            <h3>Организации</h3>
            <p>
              Политические движения, корпорации и объединения.
            </p>
          </div>

          <div class="card" onclick="openModal('Жители города')">
            <div class="card-icon">👥</div>
            <h3>Жители</h3>
            <p>
              Известные игроки, политики и жители Теней.
            </p>
          </div>

          <div class="card" onclick="openModal('Карта города')">
            <div class="card-icon">🗺️</div>
            <h3>Карта</h3>
            <p>
              Карта города, ключевые здания и важные места.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="history">
      <div class="container">
        <div class="section-heading">
          <div>
            <h2>История Теней</h2>
            <p>Хронология главных событий города</p>
          </div>
        </div>

        <div class="timeline">
          <div class="event">
            <div class="event-date">Событие 1</div>

            <div>
              <h3>Основание города</h3>
              <p>
                На территории Polit Core было основано поселение,
                которое позже получило название Тени.
              </p>
            </div>
          </div>

          <div class="event">
            <div class="event-date">Событие 2</div>

            <div>
              <h3>Появление правительства</h3>
              <p>
                В городе была создана первая система управления
                и утверждены основные правила для жителей.
              </p>
            </div>
          </div>

          <div class="event">
            <div class="event-date">Событие 3</div>

            <div>
              <h3>Развитие города</h3>
              <p>
                Тени начали активно развиваться: появились новые районы,
                предприятия и общественные организации.
              </p>
            </div>
          </div>

          <div class="event">
            <div class="event-date">Сейчас</div>

            <div>
              <h3>Современные Тени</h3>
              <p>
                Город продолжает развиваться и принимает новых жителей
                сервера Polit Core.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="articles">
      <div class="container">
        <div class="section-heading">
          <div>
            <h2>Статьи города</h2>
            <p>Материалы и документы по Теням</p>
          </div>

          <input
            id="search"
            class="search"
            type="search"
            placeholder="Поиск по статьям..."
            oninput="searchArticles()"
          >
        </div>

        <div class="articles" id="article-list">

          <article class="article" data-title="Правила города">
            <div>
              <h3>Правила города</h3>
              <p>
                Основные правила поведения жителей Теней.
              </p>
            </div>

            <span class="article-date">Новая</span>
          </article>

          <article class="article" data-title="Карта Теней">
            <div>
              <h3>Карта Теней</h3>
              <p>
                Районы, дороги, здания и важные объекты города.
              </p>
            </div>

            <span class="article-date">Карта</span>
          </article>

          <article class="article" data-title="Правительство города">
            <div>
              <h3>Правительство города</h3>
              <p>
                Структура управления и список должностных лиц.
              </p>
            </div>

            <span class="article-date">Документ</span>
          </article>

          <article class="article" data-title="Организации Теней">
            <div>
              <h3>Организации Теней</h3>
              <p>
                Список политических, военных и коммерческих организаций.
              </p>
            </div>

            <span class="article-date">Список</span>
          </article>

        </div>
      </div>
    </section>

    <section id="community">
      <div class="container">
        <div class="discord">
          <div>
            <h2>Сообщество Polit Core</h2>

            <p>
              Присоединяйся к серверу, участвуй в жизни города
              и помогай развивать Тени.
            </p>
          </div>

          <!-- Замени ссылку ниже на приглашение в свой Discord -->
          <a
            href="https://discord.com"
            target="_blank"
            class="button"
          >
            Открыть Discord
          </a>
        </div>
      </div>
    </section>

  </main>

  <footer>
    <div class="container footer-content">
      <div>
        © 2026 Тени — сервер Polit Core
      </div>

      <div>
        Страница города
      </div>
    </div>
  </footer>

  <div class="modal" id="modal" onclick="closeModal(event)">
    <div class="modal-window">
      <h2 id="modal-title">Раздел города</h2>

      <p>
        Этот раздел подготовлен для добавления информации о городе Тени.
        Здесь можно разместить текст, изображения, таблицы, карту
        и другие материалы сервера Polit Core.
      </p>

      <button class="button" onclick="closeModal()">
        Закрыть
      </button>
    </div>
  </div>

  <script>
    function toggleMenu() {
      document
        .getElementById("navigation")
        .classList.toggle("active");
    }

    function openModal(title) {
      document.getElementById("modal-title").textContent = title;
      document.getElementById("modal").classList.add("active");
    }

    function closeModal(event) {
      if (!event || event.target.id === "modal") {
        document.getElementById("modal").classList.remove("active");
      }
    }

    function searchArticles() {
      const searchText = document
        .getElementById("search")
        .value
        .toLowerCase();

      const articles = document.querySelectorAll(".article");

      articles.forEach(article => {
        const title = article
          .dataset
          .title
          .toLowerCase();

        if (title.includes(searchText)) {
          article.style.display = "flex";
        } else {
          article.style.display = "none";
        }
      });
    }
  </script>

</body>
</html>
